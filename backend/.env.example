# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM (Chat Completions, any OpenAI-compatible endpoint)
# Other base URLs: Ollama http://localhost:11434/v1, LM Studio http://localhost:1234/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4.1-mini

# Chat (small local models should use a lower char budget)
# CHAT_SYSTEM_PROMPT=You are a helpful assistant.
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_MAX_CHARS=24000
CHAT_MAX_OUTPUT_TOKENS=4096

# OpenAI (embeddings, Module 2.2)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
# Must match vector(1536) in the chunks table
EMBEDDING_DIMENSIONS=1536

# Ingestion (characters; upload limit in bytes)
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
MAX_UPLOAD_BYTES=5242880
# Dev/test only: sleep before `processing` and before `completed` so each status is visible in the UI
INGESTION_STAGE_DELAY_SECONDS=0

FRONTEND_ORIGIN=http://localhost:5173

# LangSmith (leave LANGSMITH_TRACING unset or false to disable tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-rag-masterclass
