# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Vector store created in the OpenAI dashboard (Storage -> Vector stores). Optional:
# without it, chat works but file_search is disabled.
OPENAI_VECTOR_STORE_ID=vs_...

FRONTEND_ORIGIN=http://localhost:5173

# LangSmith (leave LANGSMITH_TRACING unset or false to disable tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-rag-masterclass

# Open Router
LLM_API_KEY=sk-or-v1.....
