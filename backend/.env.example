# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM (Chat Completions, any OpenAI-compatible endpoint)
# Other base URLs: Ollama http://localhost:11434/v1, LM Studio http://localhost:1234/v1
# LLM_MODEL must support tool calling. On OpenRouter check that its supported_parameters include
# "tools" and "tool_choice": curl -s https://openrouter.ai/api/v1/models | jq '.data[] | select(.id=="<model>") | .supported_parameters'
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=openai/gpt-4.1-mini

# Chat (small local models should use a lower char budget)
# Overrides the built-in system prompt (app/services/prompts.py), which tells the model how to use search_documents
# CHAT_SYSTEM_PROMPT=You are a helpful assistant.
CHAT_HISTORY_MAX_MESSAGES=20
CHAT_HISTORY_MAX_CHARS=24000
CHAT_MAX_OUTPUT_TOKENS=4096

# OpenAI (embeddings, Module 2.2)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
# Must match vector(1536) in the chunks table
EMBEDDING_DIMENSIONS=1536

# Ingestion (characters; upload limit in bytes)
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
MAX_UPLOAD_BYTES=5242880
# Dev/test only: sleep before `processing` and before `completed` so each status is visible in the UI
INGESTION_STAGE_DELAY_SECONDS=0

# Retrieval (Module 2.3)
# Chunks returned per search_documents call
RETRIEVAL_TOP_K=5
# Minimum cosine similarity for a chunk to count as relevant. Calibrated with
# `python -m app.scripts.check_retrieval "<q>" --as <email> --threshold -1`: off-topic ~0.08-0.10,
# specific facts in a ~1500-char chunk ~0.15-0.23, paraphrases 0.4+
RETRIEVAL_MIN_SIMILARITY=0.15
# Max tool rounds per chat turn before the model is forced to answer
AGENT_MAX_TOOL_ROUNDS=3

FRONTEND_ORIGIN=http://localhost:5173

# LangSmith (leave LANGSMITH_TRACING unset or false to disable tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-rag-masterclass
